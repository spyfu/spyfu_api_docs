        "operationId": "DomainStatsApi_GetDomainStatsForExactDate_GET",
        "summary": "Domain Stats For Exact Date",
        "description": "<h3>Domain Stats</h3>Want to know what your top competitors are up to? Learn about a company’s domain history, and their current progress. Learn from their mistakes and successes.<br><a href=\"https://help.spyfu.com/en/articles/2968673-understanding-the-domain-overview-page\" target=\"_blank\">Read how to use this</a><h4>Endpoint Overview</h4>Returns the domain stats for the Domain for an exact date.",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "description": "Month to search",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "examples": [
                6
              ],
              "maximum": 12,
              "minimum": 1
