{
  "openapi": "3.1.0",
  "info": {
    "title": "Domain Stats API",
    "version": "v2"
  },
  "servers": [
    {
      "url": "/apis/domain_stats_api"
    }
  ],
  "paths": {
    "/v2/getAllDomainStats": {
      "get": {
        "operationId": "DomainStatsApi_GetAllDomainStats_GET",
        "summary": "Domain Stats For All Time",
        "description": "<h3>Domain Stats</h3>Want to know what your top competitors are up to? Learn about a company’s domain history, and their current progress. Learn from their mistakes and successes.<br><a href=\"https://help.spyfu.com/en/articles/2968673-understanding-the-domain-overview-page\" target=\"_blank\">Read how to use this</a><h4>Endpoint Overview</h4>Returns domain stats for all active dates.",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "description": "Domain to search",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "woot.com"
              ]
            },
            "example": "woot.com"
          },
          {
            "name": "countryCode",
            "in": "query",
            "description": "Country to get results for.",
            "schema": {
              "type": "string",
              "examples": [
                "US"
              ],
              "default": "US",
              "enum": [
                "AR",
                "AU",
                "BE",
                "BR",
                "CA",
                "CH",
                "DE",
                "DK",
                "ES",
                "FR",
                "IE",
                "IN",
                "IT",
                "JP",
                "MX",
                "NL",
                "NO",
                "NZ",
                "PT",
                "SE",
                "SG",
                "UA",
                "UK",
                "US",
                "ZA"
              ]
            },
            "example": "US"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiDomainStatsWrapperOutputDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "User failed authorization"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "tags": [
          "Domain Stats API"
        ]
      }
    },
