        "operationId": "DomainStatsApi_GetActiveDatesForDomain_GET",
        "summary": "Active Dates For Domain",
        "description": "<h3>Domain Stats</h3>Want to know what your top competitors are up to? Learn about a company’s domain history, and their current progress. Learn from their mistakes and successes.<br><a href=\"https://help.spyfu.com/en/articles/2968673-understanding-the-domain-overview-page\" target=\"_blank\">Read how to use this</a><h4>Endpoint Overview</h4>Returns a list of dates that we have data for the Domain.",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "description": "Domain to search",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "woot.com"
              ]
            },
            "example": "woot.com"
          },
          {
            "name": "countryCode",
            "in": "query",
            "description": "Country to get results for.",
            "schema": {
              "type": "string",
              "examples": [
                "US"
              ],
              "default": "US",
              "enum": [
                "AR",
                "AU",
                "BE",
                "BR",
                "CA",
                "CH",
                "DE",
                "DK",
                "ES",
                "FR",
                "IE",
                "IN",
                "IT",
                "JP",
                "MX",
                "NL",
                "NO",
                "NZ",
                "PT",
                "SE",
                "SG",
