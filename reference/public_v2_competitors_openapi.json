  "paths": {
    "/v2/ppc/getTopCompetitors": {
      "get": {
        "operationId": "CompetitorsApi_GetTopPpcCompetitors_GET",
        "summary": "Top PPC Competitors",
        "description": "<h3>Competitors</h3>The SpyFu Competitors API helps you find top competitors in your space. Many business owners recognize their direct competition upfront, but in online marketing, ANYONE can be a competitor.<br><a href=\"https://help.spyfu.com/en/articles/5225509-compare-yourself-against-top-competitors\" target=\"_blank\">Read how to use this</a><h4>Endpoint Overview</h4>Top PPC competitors for a domain that buys ads for the same keywords",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "description": "Domain to get competitors for",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "apple.com"
              ]
            },
            "example": "apple.com"
          },
          {
            "name": "startingRow",
            "in": "query",
            "description": "Row number to start the results with.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "examples": [
                1
              ],
              "default": 1,
              "maximum": 550,
              "minimum": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The maximum number of rows returned.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "examples": [
                5
              ],
              "default": 5,
              "maximum": 550,
              "minimum": 1
            },
            "example": 5
          },
          {
            "name": "countryCode",
            "in": "query",
            "description": "Country to get results for",
            "schema": {
              "type": "string",
              "examples": [
                "US"
              ],
              "default": "US",
              "enum": [
                "AR",
                "AU",
                "BE",
                "BR",
                "CA",
                "CH",
                "DE",
                "DK",
                "ES",
                "FR",
                "IE",
                "IN",
                "IT",
                "JP",
                "MX",
                "NL",
                "NO",
                "NZ",
                "PT",
                "SE",
                "SG",
                "UA",
                "UK",
                "US",
                "ZA"
              ]
            },
            "example": "US"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resultCount": {
                      "description": "Number of results returned",
                      "type": "integer",
                      "format": "int32",
                      "examples": [
                        50
                      ],
                      "readOnly": true
                    },
                    "totalMatchingResults": {
                      "description": "The total number of results available that matches the query including\r\nitems that might not be included in the returned results/page.",
                      "type": "integer",
                      "format": "int64"
                    },
                    "results": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "object",
                        "properties": {
                          "domain": {
                            "description": "This is the domain of the competitor that advertises on many of the same keywords that you buy in Google Ads. The more keywords you share of each other's, the higher they will be listed here as an ad rival.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "examples": [
                              "woot.com"
                            ]
                          },
                          "commonTerms": {
                            "description": "This is the count of unique keywords that this domain and your domain both advertise on.",
                            "type": "integer",
                            "format": "int32",
                            "examples": [
                              1432
                            ]
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "User failed authorization"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "tags": [
          "Competitors API"
        ]
      }
    },
